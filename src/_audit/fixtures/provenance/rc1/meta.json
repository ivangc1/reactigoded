  "scripts": {
    "_comment_prepare": "Aplica patches con patch-package SOLO en dev local (npm install desde git checkout). NO se ejecuta cuando un consumer instala reactigoded como dep.",
    "prepare": "patch-package",
    "dev": "vite",
    "build": "node scripts/build-state-css-fragments.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && vite build -c vite.lib.config.ts && node scripts/clean-internal-dist.mjs && node scripts/fix-dts-esm-extensions.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "_comment_typecheck_native": "typecheck:native usa el compilador nativo Go (tsgo, @typescript/native-preview) — ~3.7x mas rapido que tsc (medido: 3.9s vs 14.3s en este repo, 0 errores, COINCIDE con tsc). NO es autoritativo: `typescript` sigue pineado en 6.0.x (bin tsc) porque los gates AST (check-server-safe-markers, server-safe-gate.test) y typescript-eslint necesitan la Compiler API JS que TS7.0 nativo NO expone (TS2339 createSourceFile; la API vuelve en 7.1, dev builds ya en npm@next). verify:unit/CI usa tsc TS6 como fuente de verdad; native solo acelera el loop local (verify:fast). PROMOVER a autoritativo + DROP este split cuando 7.1 publique la API y typescript-eslint la soporte (issue #10940).",
    "typecheck:native": "tsgo --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:ci": "vitest run --project unit --isolate --pool=forks",
    "test:storybook": "vitest run --project storybook",
    "test:contrast": "node scripts/check-component-contrast.mjs",
    "test:scope-leaks": "node scripts/check-css-scope-leaks.mjs --strict",
    "test:hex-drift": "node scripts/check-hex-drift.mjs --strict",
    "test:state-css-exclusion": "node scripts/check-state-css-exclusion.mjs",
    "test:public-api": "node scripts/check-public-api-names.mjs",
    "test:no-dev-warns": "node scripts/check-no-dev-warns.mjs",
    "test:server-safe-markers": "node scripts/check-server-safe-markers.mjs",
    "oracle": "node scripts/runtime-oracle/run.mjs",
    "test:publint": "publint",
    "test:rsc-fixture": "tsc -p fixtures/rsc/tsconfig.json --noEmit",
    "test:consumer-types": "tsc -p fixtures/consumer-types/tsconfig.json --noEmit",
    "test:consumer-types:nodenext": "tsc -p fixtures/consumer-types-nodenext/tsconfig.json --noEmit",
    "test:consumer-pack": "node scripts/test-consumer-pack.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "_comment_build_storybook": "Genera el artefacto deployable a igoded.es con lang=es aplicado al HTML estático. NO añadir flag --output-dir aquí; el lang fix asume el default storybook-static/. Si Chromatic invoca este script, ver chromatic.config.json (apunta a build-storybook:chromatic, sin lang fix).",
    "build-storybook": "storybook build && node scripts/fix-storybook-static-lang.mjs",
    "build-storybook:chromatic": "storybook build",
    "_comment_verify_fast": "Verify rápido para iterar local: ~5 min cold (lint+typecheck+test:unit threads). Bajan ~50s con vitest cache caliente, pero el escenario típico es cold (cambia un componente, vitest reconstruye su grafo). vs ~25-30 min de verify:unit completo (--isolate --pool=forks). Sirve para iterar local; CI sigue corriendo el verify completo tras push y caza estado compartido entre tests / mocks que se filtran / divergencias de typecheck por @types instalados pero no incluidos en compilerOptions.types. Contador CI fallos con verify:fast OK: 1 (B-05 process.env.NODE_ENV — typecheck local pasó por @types/node ambient, CI strict cazó; fix: usar `import.meta.env.DEV` patrón Slider/Pagination del DS).",
    "verify:fast": "npm run lint && npm run typecheck:native && npm run test:unit",
    "verify:unit": "node scripts/clean.mjs tsconfig.tsbuildinfo && npm run lint && npm run typecheck && npm run test:unit:ci && npm run test:contrast && npm run test:scope-leaks && npm run test:hex-drift && npm run test:server-safe-markers && npm run build && npm run test:no-dev-warns && npm run test:state-css-exclusion && npm run test:public-api && npm run test:publint && npm run test:rsc-fixture && npm run test:consumer-types && npm run test:consumer-types:nodenext && npm run test:consumer-pack",
    "verify:storybook": "npm run test:storybook",
    "verify:size": "size-limit",
    "verify": "npm run verify:unit && npm run verify:storybook && npm run verify:size",
    "size": "size-limit",
    "clean": "node scripts/clean.mjs dist storybook-static coverage node_modules/.vite",
    "prepublishOnly": "npm run verify",
    "chromatic": "chromatic --exit-zero-on-changes",
    "chromatic:ci": "chromatic --exit-once-uploaded"
  },
  "size-limit": [
